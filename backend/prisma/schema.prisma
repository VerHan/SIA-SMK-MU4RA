// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// MASTER DATA
// -------------------------------------------------------------

model TahunAjar {
  id        String   @id @default(uuid())
  nama      String   // Contoh: "2024/2025"
  semester  Int      // 1 (Ganjil), 2 (Genap)
  isActive  Boolean  @default(false)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Root Relations (Semua transaksi terikat ke sini)
  riwayatKelas  RiwayatKelas[]
  jadwal        Jadwal[]
  absensi       Absensi[]
  absensiSholat AbsensiSholat[]
  absensiGuru   AbsensiGuru[]
  poinSikap     PoinSikap[]
  pembayaran    Pembayaran[]
  nilai         Nilai[]
  absensiMapel  AbsensiMapel[]
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      String   // admin, guru, staff, wali_murid, kepsek
  isPiket   Boolean  @default(false) // Hak akses khusus Guru Piket (hanya berlaku untuk role guru)
  teacherId String?  // Link ke Guru (opsional, hanya untuk role guru)
  studentId String?  // Link ke Siswa (opsional, hanya untuk role siswa/wali_murid)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guru                  Guru?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  siswa                 Siswa?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  recordedAbsensi       Absensi[]       @relation("AbsensiRecordedByUser")
  recordedAbsensiSholat AbsensiSholat[] @relation("AbsensiSholatRecordedByUser")
  recordedAbsensiMapel  AbsensiMapel[]  @relation("AbsensiMapelRecordedByUser")
  recordedAbsensiGuru   AbsensiGuru[]   @relation("AbsensiGuruRecordedByUser")

  @@index([teacherId])
  @@index([studentId])
}

model Guru {
  id          String   @id @default(uuid())
  nip         String?  @unique
  name        String
  subject     String?
  phone       String?
  role        String   @default("guru")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  jadwal                Jadwal[]
  kelasWali             Kelas[]         @relation("WaliKelas")
  absensiGuru           AbsensiGuru[]
  absensiMapel          AbsensiMapel[]
  recordedAbsensi       Absensi[]       @relation("AbsensiRecordedByGuru")
  recordedAbsensiSholat AbsensiSholat[] @relation("AbsensiSholatRecordedByGuru")
  users                 User[]
}

model Siswa {
  id             String   @id @default(uuid())
  nomor          String?  @unique
  name           String
  gender         String   @default("L")
  status         String   @default("aktif") // aktif, lulus, pindah, nonaktif
  phone          String?
  phone_parent   String?
  pekerjaan_ortu String?
  alamat         String?
  sekolah_asal   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  riwayatKelas   RiwayatKelas[]
  absensi        Absensi[]
  absensiSholat  AbsensiSholat[] @relation("AbsensiSholatSiswa")
  poinSikap      PoinSikap[]     @relation("PoinSikapSiswa")
  pembayaran     Pembayaran[]    @relation("PembayaranSiswa")
  nilai          Nilai[]
  absensiMapel   AbsensiMapel[]
  users          User[]

  @@index([status])
}

model Kelas {
  id            String   @id @default(uuid())
  name          String   @unique // Contoh: "X TKJ 1"
  grade         String   // X, XI, XII
  major         String?  @default("Umum") // TKJ, RPL
  totalStudents Int      @default(0)
  teacherId     String?  // Wali Kelas
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  waliKelas     Guru?           @relation("WaliKelas", fields: [teacherId], references: [id], onDelete: SetNull)
  riwayatKelas  RiwayatKelas[]
  jadwal        Jadwal[]
  absensi       Absensi[]
  absensiSholat AbsensiSholat[]
  absensiMapel  AbsensiMapel[]

  @@index([teacherId])
}

model Jurusan {
  id          String   @id @default(uuid())
  kode        String   @unique // Contoh: "TKJ", "RPL", "DKV"
  nama        String   // Contoh: "Teknik Komputer & Jaringan"
  deskripsi   String?
  color       String?  @default("#3B82F6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MataPelajaran {
  id       String   @id @default(uuid())
  kode     String   @unique
  nama     String
  kelompok String?  // Normatif, Adaptif, Produktif
  
  // Relations
  jadwal       Jadwal[]
  nilai        Nilai[]
  absensiMapel AbsensiMapel[]
}

model KalenderAkademik {
  id          String   @id @default(uuid())
  tanggal     DateTime @db.Date
  tipe        String   // libur, acara, ujian
  judul       String
  keterangan  String?
  jamMulai    Int?
  jamSelesai  Int?
  isFullDay   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AturanPoin {
  id        String   @id @default(uuid())
  kategori  String   // positif, negatif
  nama      String
  poin      Int
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poinSikap PoinSikap[]
}

// -------------------------------------------------------------
// TRANSACTIONAL DATA (Tied to TahunAjar)
// -------------------------------------------------------------

model RiwayatKelas {
  id          String   @id @default(uuid())
  siswaId     String
  kelasId     String
  tahunAjarId String
  createdAt   DateTime @default(now())

  // Relations
  siswa       Siswa     @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  kelas       Kelas     @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  tahunAjar   TahunAjar @relation(fields: [tahunAjarId], references: [id], onDelete: Cascade)

  @@unique([siswaId, tahunAjarId]) // 1 Siswa hanya punya 1 kelas per tahun ajar
  @@index([kelasId, tahunAjarId])
}

model Nilai {
  id          String   @id @default(uuid())
  siswaId     String
  mapelId     String
  tahunAjarId String
  jenis       String   // Tugas 1, UTS, UAS, Praktikum
  score       Int      @default(0)
  maxScore    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  siswa       Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  mapel       MataPelajaran @relation(fields: [mapelId], references: [id], onDelete: Cascade)
  tahunAjar   TahunAjar     @relation(fields: [tahunAjarId], references: [id], onDelete: Cascade)

  @@index([siswaId, tahunAjarId])
}

model Jadwal {
  id          String   @id @default(uuid())
  day         String
  time        String
  jamKe       Int?
  subjectId   String
  teacherId   String
  kelasId     String?
  className   String   // Nama kelas untuk display cepat
  room        String?
  tahunAjarId String?

  subject     MataPelajaran @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Guru          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  kelas       Kelas?        @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  tahunAjar   TahunAjar?    @relation(fields: [tahunAjarId], references: [id], onDelete: SetNull)

  @@index([day, jamKe])
  @@index([className, day])
  @@index([kelasId, day])
  @@index([teacherId])
  @@index([subjectId])
}

model Absensi {
  id               String   @id @default(uuid())
  studentId        String
  kelasId          String?
  tahunAjarId      String?
  recordedByUserId String?
  recordedByGuruId String?
  date             DateTime @db.Date
  statusPagi       String?
  statusSore       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  student        Siswa      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kelas          Kelas?     @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  tahunAjar      TahunAjar? @relation(fields: [tahunAjarId], references: [id], onDelete: SetNull)
  recordedByUser User?      @relation("AbsensiRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  recordedByGuru Guru?      @relation("AbsensiRecordedByGuru", fields: [recordedByGuruId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([date])
  @@index([kelasId, date])
  @@index([recordedByUserId])
  @@index([recordedByGuruId])
}

model AbsensiSholat {
  id               String   @id @default(uuid())
  studentId        String
  kelasId          String?
  tahunAjarId      String?
  recordedByUserId String?
  recordedByGuruId String?
  date             DateTime @db.Date
  dzuhur           Boolean  @default(false)
  ashar            Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student        Siswa      @relation("AbsensiSholatSiswa", fields: [studentId], references: [id], onDelete: Cascade)
  kelas          Kelas?     @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  tahunAjar      TahunAjar? @relation(fields: [tahunAjarId], references: [id], onDelete: SetNull)
  recordedByUser User?      @relation("AbsensiSholatRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  recordedByGuru Guru?      @relation("AbsensiSholatRecordedByGuru", fields: [recordedByGuruId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([date])
  @@index([kelasId, date])
}

model PoinSikap {
  id           String   @id @default(uuid())
  siswaId      String
  tahunAjarId  String?
  tanggal      DateTime @db.Date
  aturanPoinId String
  poin         Int
  keterangan   String?
  pencatat     String?
  createdAt    DateTime @default(now())

  siswa        Siswa      @relation("PoinSikapSiswa", fields: [siswaId], references: [id], onDelete: Cascade)
  aturanPoin   AturanPoin @relation(fields: [aturanPoinId], references: [id], onDelete: Cascade)
  tahunAjar    TahunAjar? @relation(fields: [tahunAjarId], references: [id], onDelete: SetNull)

  @@index([siswaId, tanggal])
}

model Pembayaran {
  id          String    @id @default(uuid())
  studentId   String
  tahunAjarId String?
  type        String    // SPP, Seragam, dll
  month       String    // Juli, Agustus, dll
  amount      Int
  paid        Int       @default(0)
  status      String    // lunas, cicilan, belum
  date        DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student     Siswa      @relation("PembayaranSiswa", fields: [studentId], references: [id], onDelete: Cascade)
  tahunAjar   TahunAjar? @relation(fields: [tahunAjarId], references: [id], onDelete: SetNull)
}

// -------------------------------------------------------------
// OTHERS
// -------------------------------------------------------------

model AbsensiGuru {
  id               String   @id @default(uuid())
  guruId           String
  tahunAjarId      String?
  recordedByUserId String?
  tanggal          DateTime @db.Date
  status           String   // hadir, izin, sakit, alpha
  sumber           String   // gps, manual
  jamMasuk         String?
  jamPulang        String?
  jarakMeter       Int?
  keterangan       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guru           Guru       @relation(fields: [guruId], references: [id], onDelete: Restrict)
  tahunAjar      TahunAjar? @relation(fields: [tahunAjarId], references: [id], onDelete: SetNull)
  recordedByUser User?      @relation("AbsensiGuruRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@unique([guruId, tanggal])
  @@index([tanggal])
  @@index([recordedByUserId])
}

model LogAktivitas {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SystemHeartbeat {
  id          String   @id @default(uuid())
  pingType    String   // 'AUTO_BOT' atau 'MANUAL_ADMIN'
  triggeredBy String   // nama user admin atau 'CRON_WORKER'
  createdAt   DateTime @default(now())
  note        String?

  @@index([createdAt])
}

model KelompokMapel {
  id        String   @id @default(uuid())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AbsensiMapel {
  id               String   @id @default(uuid())
  studentId        String
  mapelId          String
  guruId           String
  kelasId          String?
  recordedByUserId String?
  kelasName        String   // Nama kelas untuk display cepat
  tahunAjarId      String?
  date             DateTime @db.Date
  jamKe            Int      // Jam pelajaran ke berapa
  status           String   // hadir, izin, sakit, alpha
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student        Siswa         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mapel          MataPelajaran @relation(fields: [mapelId], references: [id], onDelete: Restrict)
  guru           Guru          @relation(fields: [guruId], references: [id], onDelete: Restrict)
  kelas          Kelas?        @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  tahunAjar      TahunAjar?    @relation(fields: [tahunAjarId], references: [id], onDelete: SetNull)
  recordedByUser User?         @relation("AbsensiMapelRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@unique([studentId, mapelId, date, jamKe])
  @@index([kelasName, date])
  @@index([kelasId, date])
  @@index([studentId, date])
  @@index([guruId, date])
  @@index([date, jamKe])
}

model MasterSesi {
  id        String   @id @default(uuid())
  order     Int      @default(0)
  jamKe     Int?
  type      String   @default("pelajaran") // pelajaran | istirahat
  start     String   // HH:mm
  end       String   // HH:mm
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Berita {
  id          String   @id @default(uuid())
  title       String
  excerpt     String
  content     String
  category    String   @default("Pengumuman")
  author      String   @default("Admin")
  date        DateTime @db.Date
  image       String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PpdbRegistration {
  id           String   @id @default(uuid())
  regNumber    String   @unique
  name         String
  nisn         String?
  gender       String   @default("L")
  schoolOrigin String
  majorChoice  String
  phoneStudent String
  phoneParent  String
  email        String?
  address      String
  track        String   @default("Reguler")
  status       String   @default("Menunggu Verifikasi") // Menunggu Verifikasi | Diterima | Cadangan | Ditolak
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

